# Non-secret Firebase Functions parameters. Copy to functions/.env and adjust.
# AI_PROVIDER selects which provider AI_API_KEY belongs to: gemini | openai | anthropic
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
OPENAI_MODEL=gpt-5.1
ANTHROPIC_MODEL=claude-sonnet-5

# The key itself is a secret. Locally put AI_API_KEY=... in functions/.env.local
# (git-ignored); for deploys use: npx firebase functions:secrets:set AI_API_KEY
